{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "日次投稿パッケージ",
  "description": "毎晩のルーティンが posts/YYYY-MM-DD.json として書き出す形式。GitHub Actions がこれを読んで投稿する。",
  "type": "object",
  "required": ["date", "posts"],
  "additionalProperties": true,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "投稿日(JST)。ファイル名と一致させる" },
    "weekday": { "type": "string" },
    "phase": { "type": "string", "enum": ["Phase 0", "Phase 0.5", "Phase 1"] },
    "generated_at": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "posts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/post" }
    }
  },
  "$defs": {
    "post": {
      "type": "object",
      "required": ["slot", "title", "main_text", "format_type"],
      "additionalProperties": true,
      "properties": {
        "slot": { "enum": ["morning", "noon", "evening", "night"] },
        "time_jst": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["宿泊", "観光", "体験", "食", "交通"] },
        "format_type": {
          "enum": ["単体スポット紹介", "リスト型", "常識の裏切り", "比較・選び方", "季節カレンダー"]
        },
        "area": { "type": "string" },
        "main_text": {
          "type": "string",
          "maxLength": 500,
          "description": "Threads本文。上限500字（改行も1字）。リンクありなら【PR】で始める。URLを含めてはならない"
        },
        "link_url": {
          "type": "string",
          "description": "アフィリエイトURL。空ならガードで枠を落とす"
        },
        "reply_text": {
          "type": "string",
          "maxLength": 500,
          "description": "PR\\n\\n料金・空室はこちら👇\\n<URL> の構造。build_reply.py が生成する"
        },
        "image_url": {
          "type": "string",
          "description": "公開アクセス可能なhttps URL（Threads APIが取得する）。署名URL推奨"
        },
        "require_image": {
          "type": "boolean",
          "default": true,
          "description": "trueなら画像が用意できない場合に枠を落とす（テキストのみでの代替はしない）"
        },
        "image_route": { "type": "string", "description": "③ASP素材 / ④商用可ストック / ⑤自作の文字情報カード（写真なし） のいずれか" },
        "image_needs_specific_facility": {
          "type": "boolean",
          "description": "施設特定写真が必要か。trueなら風景素材での代替は不可"
        },
        "expires_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "この日を過ぎたら投稿しない（例: 雲海テラスは2026-10-13）"
        },
        "asp": { "type": "string" },
        "source_checks": {
          "type": "array",
          "description": "投稿直前の一次ソース生存確認。1つでも外れたら投稿しない",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "must_contain": { "type": "array", "items": { "type": "string" } },
              "must_not_contain": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
